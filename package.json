{
  "name": "clean-chars",
  "displayName": "CleanChars",
  "description": "Detect and clean suspicious Unicode characters in your code",
  "version": "0.0.1",
  "engines": {
    "vscode": "^1.103.0"
  },
  "categories": [
    "Other"
  ],
  "main": "./out/extension.js",
  "activationEvents": [
    "onStartupFinished"
  ],
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "cleanChars",
          "title": "CleanChars",
          "icon": "resources/clean-code-svgrepo-com.svg"
        }
      ]
    },
    "views": {
      "cleanChars": [
        {
          "id": "cleanChars.issues",
          "name": "Issues",
          "type": "webview"
        }
      ]
    },
    "configuration": {
      "title": "CleanChars",
      "properties": {
        "cleanChars.exclude": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Glob patterns to exclude from workspace scans. node_modules, .git, out, dist, and build are always excluded."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "pretest": "npm run compile && npm run lint",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.103.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "24.x",
    "typescript-eslint": "^8.61.1",
    "eslint": "^10.5.0",
    "typescript": "^6.0.3",
    "@vscode/test-cli": "^0.0.15",
    "@vscode/test-electron": "^3.0.0"
  },
  "overrides": {
    "diff": "^8.0.4",
    "serialize-javascript": "^7.0.6"
  }
}
